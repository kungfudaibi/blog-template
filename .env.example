# Public canonical origin used by metadata, sitemap, and RSS.
# Replace with the stable Vercel URL until a custom domain is purchased.
SITE_URL=http://localhost:3000

# Cloudflare Workers AI server-only configuration.
# Keep the Cloudflare account on Workers Free to guarantee no charge.
# This application never upgrades billing plans or switches to a paid fallback.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_API_TOKEN=
# Optional: the application uses this Free-plan model by default.
CLOUDFLARE_AI_MODEL=@cf/qwen/qwen3-30b-a3b-fp8
